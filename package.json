{
  "name": "gestionnaire-de-notes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Suivi de scolarité BUT1 Informatique (notes, emploi du temps, devoirs) — PWA statique hébergée sur GitHub Pages.",
  "scripts": {
    "test": "vitest run",
    "test:golden": "vitest run tests/golden",
    "test:unit": "vitest run tests/unit tests/golden",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run check:css && vitest run && playwright test",
    "lint": "eslint .",
    "build": "npm run vendor && npm run build:css && npm run build:icons",
    "build:css": "tailwindcss -c tailwind.config.cjs -i assets/css/tailwind.input.css -o assets/css/tailwind.css --minify",
    "build:icons": "node scripts/build-icons.mjs",
    "check:css": "node scripts/check-css.mjs",
    "vendor": "node scripts/vendor.mjs",
    "serve": "node tests/mock-server/server.mjs --static --port 4173",
    "smoke:edt": "node scripts/smoke-edt.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@fontsource-variable/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "@playwright/test": "1.64.0",
    "@supabase/supabase-js": "2.117.3",
    "jsdom": "30.1.2",
    "tailwindcss": "3.4.19",
    "vitest": "5.0.4"
  }
}
